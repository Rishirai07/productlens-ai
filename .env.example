# Copy this file to `.env` and fill in the key for the provider you chose.
# `.env` is in .gitignore, so your real key never goes to GitHub.

# Which provider to use: gemini | openai | anthropic
LLM_PROVIDER=gemini

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model names change often, so check your provider's docs for current ones.
LLM_MODEL=
